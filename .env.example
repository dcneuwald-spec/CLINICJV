# ============================================================
# ClinicJV — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores.
# ============================================================

# ── Banco de Dados ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/clinicjv"
# Supabase, Neon ou Railway são recomendados para produção.

# ── NextAuth ────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="substitua-por-chave-aleatoria-segura"
# Gere com: openssl rand -base64 32

# ── WhatsApp ────────────────────────────────────────────────
# Provedor ativo: zapi | evolution | meta  (padrão: zapi)
WHATSAPP_PROVIDER="zapi"

# Z-API — https://z-api.io
# Crie uma instância no painel e copie o Instance ID e Token.
# Plano gratuito disponível com limite mensal de mensagens.
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""   # opcional — segurança adicional

# Evolution API — https://github.com/EvolutionAPI/evolution-api
# Open source, auto-hospedável via Docker.
EVOLUTION_API_URL=""         # ex: https://evolution.meudominio.com
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""        # nome da instância no painel

# Meta WhatsApp Business API — https://developers.facebook.com/docs/whatsapp
# Requer conta Meta Business verificada.
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
META_VERIFY_TOKEN=""         # token para verificação de webhook

# ── Lembretes automáticos (Cron) ───────────────────────────
# Protege o endpoint POST /api/whatsapp/reminders.
# Agendadores externos devem enviar: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ── E-mail ──────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@clinicjv.com.br"

# ── Integrações opcionais ───────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
